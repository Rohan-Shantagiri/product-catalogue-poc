# API configuration. Empty values use the API defaults.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=false
PRODUCT_SOURCE=fakestore
FAKESTORE_BASE_URL=https://fakestoreapi.com
UPSTREAM_TIMEOUT_MS=5000
CATALOGUE_CACHE_TTL_SECONDS=300
CATALOGUE_CURRENCY=AUD
IMAGE_ALLOWED_HOSTS=fakestoreapi.com
MERCHANDISING_FILE=config/merchandising.json
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SALES_INBOX_EMAIL=sales@example.com
ENQUIRY_FROM_EMAIL=enquiries@example.com
PUBLIC_WEB_URL=http://localhost:5173
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=600

# Host port mappings for Docker Compose.
WEB_PORT=8080
API_PORT=3000
MAILPIT_UI_PORT=8025
