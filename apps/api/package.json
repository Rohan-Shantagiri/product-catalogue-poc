{
  "name": "@catalogue/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "snapshot": "tsx --env-file-if-exists=../../.env scripts/snapshot-fakestore.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@catalogue/contracts": "0.1.0",
    "@koa/bodyparser": "6.1",
    "@koa/router": "^15.7",
    "koa": "^3.3",
    "koa-ratelimit": "^6.0.0",
    "nodemailer": "10.6",
    "pino": "^10",
    "zod": "^4.6"
  },
  "devDependencies": {
    "@types/koa": "^3",
    "@types/koa-ratelimit": "^6.0.0",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7",
    "supertest": "^7.3",
    "tsx": "^4.23",
    "vitest": "^5.1"
  }
}
